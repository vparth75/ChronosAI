# Chronos server environment template
# Copy this file to `.env` and fill in your own secrets before running the backend.

# 1. Gemini API Key (Required for LLM synthesis)
GEMINI_API_KEY="your-gemini-api-key"

# 2. Application Security Key (shared secret for the X-API-Key header)
API_KEY_SECRET="generate-a-strong-secret"
